{
	"apiVersion": 3,
	"name": "vern_shipping_block/cart-items-features-block",
	"version": "2.0.0",
	"title": "Cart Items Features!",
	"category": "woocommerce",
	"description": "Adds cart item features to the cart and checkout.",
	"supports": {
		"html": false,
		"align": false,
		"multiple": false,
		"reusable": false
	},
	"parent": ["woocommerce/mini-cart-items-block", "woocommerce/cart-items-block", "woocommerce/checkout-order-summary-block"],
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		},
		"text": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-vern_shipping_block-cart-items-features-block",
			"default": ""
		}
	},
	"textdomain": "vern_shipping_block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:../../../build/style-vern_shipping_block-cart-items-features-block.css",
	"style": "file:./style.css"
}
