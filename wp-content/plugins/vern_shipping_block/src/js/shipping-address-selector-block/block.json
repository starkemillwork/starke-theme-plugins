{
	"apiVersion": 3,
	"name": "vern_shipping_block/shipping-address-selector-block",
	"version": "2.0.0",
	"title": "Shipping Address Selector",
	"category": "woocommerce",
	"description": "Adds ability to select from saved shipping addresses to the checkout.",
	"supports": {
		"html": false,
		"align": false,
		"multiple": false,
		"reusable": false
	},
	"parent": ["woocommerce/checkout-fields-block"],
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		},
		"text": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-vern_shipping_block-shipping-address-selector-block",
			"default": ""
		}
	},
	"textdomain": "vern_shipping_block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:../../../build/style-vern_shipping_block-shipping-address-selector-block.css",
	"style": "file:./style.css"
}
