#. Plugin Name of the plugin
msgid "WP Grid Builder - Caching"
msgstr "WP Grid Builder - Caching"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://www.wpgridbuilder.com"
msgstr "https://www.wpgridbuilder.com"

#. Description of the plugin
msgid ""
"Speed up loading time when filtering grids by caching content and facets."
msgstr ""
"Accélérez le temps de chargement lors du filtrage des grilles en mettant en "
"cache le contenu et les facettes."

#. Author of the plugin
msgid "Loïc Blascos"
msgstr "Loïc Blascos"

